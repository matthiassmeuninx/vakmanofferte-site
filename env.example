# Claude API (console.anthropic.com)
CLAUDE_API_KEY=sk-ant-JOUW_SLEUTEL_HIER

# 360dialog WhatsApp Business API (app.360dialog.com)
WHATSAPP_API_KEY=JOUW_360DIALOG_SLEUTEL
WHATSAPP_NUMBER=+32XXXXXXXXX

# Server
PORT=3000
NODE_ENV=development

# Jouw eigen info (voor standaard replies)
BEDRIJF_NAAM=VakmanOfferte
CONTACT_EMAIL=info@vakmanofferte.be

# Webhook verificatie token (zelf te kiezen, willekeurige string)
WEBHOOK_VERIFY_TOKEN=mijn_geheime_token_123
